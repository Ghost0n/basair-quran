# Copy this file to `.env.production` before the first Hetzner deployment.
# For public deployments, prefer per-user Ollama keys from the research UI
# and leave OLLAMA_API_KEY empty unless you also add application auth/quotas.

COMPOSE_PROJECT_NAME=qbasair

QBASAIR_PUBLIC_DOMAIN=your-domain.example
QBASAIR_ENABLE_TLS=1

# DuckDNS DNS challenge for TLS certificates (shared with co-located stacks).
# Certs are stored on the host at /srv/letsencrypt — mount once, used by all.
DUCKDNS_TOKEN=your-duckdns-token
CERTBOT_EMAIL=you@example.com

QBASAIR_BUILD_DB_ON_START=auto
QBASAIR_LOW_MEMORY_MODE=1

QBASAIR_LLM_PROVIDER=ollama
QBASAIR_OLLAMA_BASE_URL=https://ollama.com
QBASAIR_LLM_CHAT_MODEL=gemma4:31b-cloud
QBASAIR_LLM_EMBED_MODEL=nomic-embed-text
QBASAIR_LLM_TIMEOUT_SECONDS=180

# Community moderation (docs/community-moderation-design.md): the `worker`
# service checks queued posts, new comments and reports every interval, with at
# most DAILY_BUDGET agent calls per UTC day; a less confident answer goes to a person.
QBASAIR_MODERATION_INTERVAL_SECONDS=900
QBASAIR_MODERATION_DAILY_BUDGET=2000
QBASAIR_MODERATION_MIN_CONFIDENCE=0.7
# Feedback centre: messages per IP per rate-limit window.
QBASAIR_RATE_LIMIT_FEEDBACK_MAX=10

QBASAIR_API_ORIGIN=http://api:8001
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_ENABLE_YAMLI=0

QBASAIR_AUTH_ENABLED=1
NEXT_PUBLIC_AUTH_ENABLED=1
QBASAIR_AUTH_DB_PATH=/app/data/auth.db
QBASAIR_SESSION_COOKIE_NAME=qbasair_session
QBASAIR_SESSION_SECRET=change-me-to-a-long-random-secret
QBASAIR_SESSION_SECURE=1

# Invite-only signup for a first public release: comma-separated invite codes.
# Leave empty for open signup.
QBASAIR_INVITE_CODES=
# Extra Ollama hosts clients may target besides ollama.com (comma-separated).
QBASAIR_OLLAMA_ALLOWED_HOSTS=

# Same-origin browser traffic does not require CORS, but this remains useful
# when you run a second trusted frontend origin.
QBASAIR_CORS_ORIGINS=https://your-domain.example

# Leave blank for bring-your-own-key mode.
OLLAMA_API_KEY=

# Password-reset email (optional). Without QBASAIR_SMTP_HOST the reset token is
# only written to the API log for manual delivery.
QBASAIR_PUBLIC_URL=https://your-domain.example
QBASAIR_SMTP_HOST=
QBASAIR_SMTP_PORT=587
QBASAIR_SMTP_USER=
QBASAIR_SMTP_PASSWORD=
# starttls (587) | ssl (465) | none
QBASAIR_SMTP_SECURITY=starttls
QBASAIR_MAIL_FROM="بصائر <no-reply@your-domain.example>"

# Sign-in with Keycloak (docs/keycloak.md) — keep "local" until the platform's
# Keycloak is live; then set the issuer, the web client's secret and the public URL.
QBASAIR_AUTH_PROVIDER=local
QBASAIR_OIDC_ISSUER=
QBASAIR_OIDC_INTERNAL_URL=
QBASAIR_OIDC_CLIENT_SECRET=
