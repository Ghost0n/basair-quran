# Q-Basair production settings (docs/deployment.md).
#
# Copy to /srv/q-basair/.env.production on the server (chmod 600, owned by the
# `deploy` user) and fill in the values marked CHANGE. This file is never
# committed; the deploy reads it from the server.

COMPOSE_PROJECT_NAME=qbasair

# --- The site --------------------------------------------------------------

QBASAIR_PUBLIC_DOMAIN=basairquran.com
QBASAIR_PUBLIC_URL=https://basairquran.com
# HTTPS through Let's Encrypt (deploy/server/tls.sh). Keep 1; nginx serves
# plain HTTP only until the certificate exists.
QBASAIR_ENABLE_TLS=1
# The address Let's Encrypt writes to about the certificate. CHANGE
CERTBOT_EMAIL=you@example.org
# Same-origin traffic needs no CORS; list other trusted front-end origins here.
QBASAIR_CORS_ORIGINS=https://basairquran.com

# Behind Cloudflare (docs/deployment.md → "Cloudflare"): its address ranges,
# comma-separated, and the header carrying the visitor's IP. Leave both empty
# when the domain points straight at the server.
QBASAIR_CDN_TRUSTED_RANGES=
QBASAIR_CDN_REAL_IP_HEADER=

# --- Images ----------------------------------------------------------------
# Set by deploy/server/deploy.sh on every deploy (the commit deployed); the
# prefix is the GitHub Container Registry path of the repository.
QBASAIR_IMAGE_PREFIX=ghcr.io/ghost0n/basair-quran
QBASAIR_IMAGE_TAG=latest

# --- Accounts --------------------------------------------------------------

QBASAIR_AUTH_ENABLED=1
QBASAIR_AUTH_DB_PATH=/app/data/auth.db
QBASAIR_SESSION_COOKIE_NAME=qbasair_session
# openssl rand -hex 48  CHANGE
QBASAIR_SESSION_SECRET=
QBASAIR_SESSION_SECURE=1
# Invite-only sign-up (local accounts only): comma-separated codes. Empty: open sign-up.
QBASAIR_INVITE_CODES=

# --- Sign-in with Keycloak (docs/deployment.md → "Keycloak") ---------------
# Keycloak owns credentials, the 6-digit email codes, password resets, 2FA and
# the linked providers; it runs with the `keycloak` profile at QBASAIR_AUTH_DOMAIN
# (an A/AAAA record to this server; tls.sh issues its certificate). For local
# accounts in auth.db instead: QBASAIR_AUTH_PROVIDER=local and no profile.
COMPOSE_PROFILES=keycloak
QBASAIR_AUTH_PROVIDER=keycloak
QBASAIR_AUTH_DOMAIN=auth.basairquran.com
QBASAIR_OIDC_ISSUER=https://auth.basairquran.com/realms/qbasair
QBASAIR_OIDC_INTERNAL_URL=http://keycloak:8080
# The web client's secret, shared by the API and the realm: openssl rand -hex 32  CHANGE
QBASAIR_OIDC_CLIENT_SECRET=
# Keycloak's PostgreSQL password: openssl rand -hex 24  CHANGE
KC_DB_PASSWORD=
# The admin console's first administrator, created on Keycloak's first start
# (the console: ssh -L 8180:127.0.0.1:8180 deploy@<server>, then
# http://localhost:8180/admin/). openssl rand -hex 24  CHANGE
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
# Keycloak's mail (the sign-up codes, password resets): the Infomaniak mailbox;
# noreply@ is an alias of contact@. Without it new accounts can't verify their email.  CHANGE
KC_SMTP_HOST=mail.infomaniak.com
KC_SMTP_PORT=587
KC_SMTP_USER=contact@basairquran.com
KC_SMTP_PASSWORD=
KC_SMTP_FROM=noreply@basairquran.com
# Sign-in providers, each added when its keys are set. Redirect address to
# register with the provider: https://<auth domain>/realms/qbasair/broker/<google|facebook>/endpoint
KC_GOOGLE_CLIENT_ID=
KC_GOOGLE_CLIENT_SECRET=
KC_FACEBOOK_CLIENT_ID=
KC_FACEBOOK_CLIENT_SECRET=
# The realm is imported on Keycloak's FIRST start only; later changes to these
# values are made in the admin console (docs/deployment.md → "Keycloak").

# --- Email (password reset, answers) ---------------------------------------
# Without QBASAIR_SMTP_HOST no reset email is sent (the token is never logged).
QBASAIR_SMTP_HOST=
QBASAIR_SMTP_PORT=587
QBASAIR_SMTP_USER=
QBASAIR_SMTP_PASSWORD=
# starttls (587) | ssl (465) | none
QBASAIR_SMTP_SECURITY=starttls
QBASAIR_MAIL_FROM="بصائر <no-reply@basairquran.com>"
# Where contact-form messages are forwarded (also kept in the feedback centre).
QBASAIR_CONTACT_EMAIL=contact@basairquran.com

# --- Research agent / AI ---------------------------------------------------

QBASAIR_LLM_PROVIDER=ollama
QBASAIR_OLLAMA_BASE_URL=https://ollama.com
QBASAIR_LLM_CHAT_MODEL=gemma4:31b-cloud
QBASAIR_LLM_EMBED_MODEL=nomic-embed-text
QBASAIR_LLM_TIMEOUT_SECONDS=180
# The server's own Ollama key (the demo allowance and community moderation).
# Leave empty for bring-your-own-key only.
OLLAMA_API_KEY=
# Extra Ollama hosts a client may target besides ollama.com (comma-separated).
QBASAIR_OLLAMA_ALLOWED_HOSTS=

# --- Community moderation (docs/community-moderation-design.md) -----------

QBASAIR_MODERATION_INTERVAL_SECONDS=900
QBASAIR_MODERATION_DAILY_BUDGET=2000
QBASAIR_MODERATION_MIN_CONFIDENCE=0.7
# Feedback centre: messages per IP per rate-limit window.
QBASAIR_RATE_LIMIT_FEEDBACK_MAX=10

# --- Data ------------------------------------------------------------------

# Rebuild quran.db at start-up only when it is missing or outdated.
QBASAIR_BUILD_DB_ON_START=auto
QBASAIR_LOW_MEMORY_MODE=0
# Recitations prepared on a deploy tagged [prepare-recitations]
# (docs/deployment.md → "Preparing the recitations"): "configured" (the
# reciters in scripts/recitation_sources.json, ~8 GB), "all" (~70 GB) or a
# comma-separated list of ids.
QBASAIR_PREPARE_RECITERS=configured

# --- Resources (a Contabo Cloud VPS 20/30; lower them on a smaller server) -

QBASAIR_API_MEM_LIMIT=2g
QBASAIR_API_CPUS=2
QBASAIR_WORKER_MEM_LIMIT=512m
QBASAIR_WORKER_CPUS=0.5
QBASAIR_WEB_MEM_LIMIT=768m
QBASAIR_WEB_CPUS=1.5
QBASAIR_NGINX_MEM_LIMIT=128m
QBASAIR_NGINX_CPUS=0.5
QBASAIR_KEYCLOAK_MEM_LIMIT=1g
QBASAIR_KEYCLOAK_CPUS=1.0
QBASAIR_KEYCLOAK_DB_MEM_LIMIT=256m
QBASAIR_KEYCLOAK_DB_CPUS=0.5

# --- Web (read at run time; the build-time values come from the release
# workflow's repository variables) -------------------------------------------

QBASAIR_API_ORIGIN=http://api:8001
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_AUTH_ENABLED=1

# --- Backups (deploy/server/backup.sh, nightly cron) -----------------------
QBASAIR_BACKUP_RETENTION_DAYS=14
