limit_req_zone $binary_remote_addr zone=api_general:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=api_research:10m rate=6r/m;
limit_conn_zone $binary_remote_addr zone=per_ip_conn:10m;

upstream qbasair_web {
    server web:3000;
    keepalive 32;
}

upstream qbasair_api {
    server api:8001;
    keepalive 32;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name ${QBASAIR_SERVER_NAME};

    client_max_body_size 1m;

    add_header X-Content-Type-Options "nosniff" always;
    # HIT / MISS / STALE / UPDATING on cached API responses (empty elsewhere).
    add_header X-Cache-Status $upstream_cache_status always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://api.yamli.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self' https://api.qurancdn.com https://www.mp3quran.net; media-src 'self' https://everyayah.com https://download.quranicaudio.com https://*.mp3quran.net; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; frame-src 'none'" always;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location = /healthz {
        access_log off;
        return 200 'ok';
        add_header Content-Type text/plain;
    }

    location = /api/research-agent {
        limit_conn per_ip_conn 20;
        limit_req zone=api_research burst=3 nodelay;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_read_timeout 180s;
        proxy_connect_timeout 15s;
        proxy_send_timeout 180s;
        proxy_pass http://qbasair_api;
    }

    # Prepared recitations (scripts/build_recitations.py): static files with
    # byte ranges, versioned by ?v= so they never change; the standalone app
    # streams them from another origin. (add_header here replaces the
    # server's headers, so the ones that matter are repeated.)
    location ~ "^/api/recitations/audio/([a-z0-9][a-z0-9-]*)/([0-9]{3})\.mp3$" {
        alias /srv/recitations/$1/$2.mp3;
        types { }
        default_type audio/mpeg;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location /api/ {
        limit_conn per_ip_conn 30;
        limit_req zone=api_general burst=30 nodelay;

        # Shared cache (nginx.conf): identical requests from any user are served
        # from one stored copy. Concurrent misses for the same URL wait for a
        # single upstream fetch (no thundering herd on a popular page), and an
        # expired entry keeps being served while ONE background refresh runs —
        # or while the API is briefly down.
        proxy_cache qbasair_api;
        proxy_cache_key $scheme$host$request_uri;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 10s;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        proxy_cache_revalidate on;
        proxy_cache_bypass $qbasair_no_edge_cache;
        proxy_no_cache $qbasair_no_edge_cache;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_read_timeout 60s;
        proxy_connect_timeout 15s;
        proxy_send_timeout 60s;
        proxy_pass http://qbasair_api;
    }

    location /_next/static/ {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_pass http://qbasair_web;
        expires 1y;
        add_header Cache-Control "public, immutable" always;
    }

    location / {
        limit_conn per_ip_conn 50;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_read_timeout 60s;
        proxy_connect_timeout 15s;
        proxy_send_timeout 60s;
        proxy_pass http://qbasair_web;
    }
}
